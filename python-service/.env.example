# API Key 现已通过前端「系统设置」界面配置，加密存储于 config/settings.json
# 此文件仅保留非敏感的环境配置；DEEPSEEK_API_KEY 留空作为兼容 fallback
DEEPSEEK_API_KEY=
DATABASE_URL=mysql+pymysql://root@localhost:3306/investment_compass?charset=utf8mb4
# HITL checkpointer（Redis Stack）与行情缓存/软取消标记共用
# 启动：docker compose -f docker-compose.redis.yml up -d
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8002
