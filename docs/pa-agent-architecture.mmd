        E4[策略文件库<br/>28+策略文件]
        E1 --> E4
        E2 --> E4
    end

    subgraph "容错层"
        F1[RetryPolicy]
        F2[RetryFeedback]
        F3[ValidationMessages]
    end

    subgraph "记录持久化"
        G1[AnalysisRecord]
    end

